# OS
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store

# Editor / IDE
.vscode/
.idea/
*.swp
*~

# Log e temporanei
*.log
node_modules/
dist/
.tmp/

# Build app Android (Capacitor) — generati in automatico, non vanno versionati
www/
android/
package-lock.json

# APK scaricato in locale per l'installazione via WiFi (non versionare)
*.apk
# Pacchetto per Google Play: 14MB di roba ricompilabile in due minuti dal workflow.
*.aab

# ⚠️ CHIAVE DI FIRMA. Non deve MAI finire qui dentro: il repository e' pubblico, e chi ha
# la chiave (con la password) puo' firmare aggiornamenti a nome dell'autore. Questa riga e'
# una rete: la chiave va tenuta FUORI dalla cartella del gioco, non solo ignorata.
*.keystore
*.jks

# Strumento di upscale usato una volta per gli sfondi (110MB tra modelli e cache).
# NON serve al gioco: l'upscale e' stato ABBANDONATO, gli sfondi si generano gia' grandi.
chainner/

# SFONDI: nel repository ci vanno SOLO i tre file cotti di ogni set (bg<N>_far/mid/near), non le
# sorgenti da cui si ricavano. ⚠️ Le sorgenti sono 16 MB in tutto e servono una volta sola, alla
# cottura: restano sul disco di chi lavora, non nella cronologia di tutti. E' la stessa regola gia'
# scritta per gli sprite ("le sorgenti stanno in art_sources/, fuori da assets/"), che per gli
# sfondi non era mai stata applicata.

# Registrazioni schermo occasionali
*.mp4

# Schermate generate da tools/schermata.py: usa e getta, non vanno versionate
schermata*.png

# Cache di Python creata quando gli strumenti in tools/ si importano fra loro
__pycache__/

# Screenshot e GIF generati da tools/foto.py: materiale di lavoro, non del gioco
foto_*.png
foto_*.gif

assets/backgrounds/*/*
!assets/backgrounds/*/bg*_far.jpg
!assets/backgrounds/*/bg*_mid.png
!assets/backgrounds/*/bg*_near.png
